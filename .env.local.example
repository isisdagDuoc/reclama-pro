# Firebase Admin (servidor) — JSON completo del service account
# NO usar variables separadas: Vercel escapa \n del private_key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Client (browser) — desde Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL pública de la app — usada en actionCodeSettings de Firebase Auth (reset de contraseña)
# En desarrollo: http://localhost:3000
# En producción: la URL de Vercel (ej: https://reclama-pro.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sesión — string random mínimo 32 caracteres
# Generar con: openssl rand -base64 32
SESSION_SECRET=
