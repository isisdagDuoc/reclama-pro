# Firebase Admin (servidor) — JSON completo del service account
# NO usar variables separadas: Vercel escapa \n del private_key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Client (browser) — desde Firebase Console → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# URL pública de la app — requerida por sendPasswordResetEmail (corre en el browser, no puede leer VERCEL_URL)
# Local: http://localhost:3000
# Vercel Production: https://reclama-pro.vercel.app (o tu dominio)
# Vercel Preview: NO configurar — el Server Component usa VERCEL_URL automáticamente
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sesión — string random mínimo 32 caracteres
# Generar con: openssl rand -base64 32
SESSION_SECRET=
